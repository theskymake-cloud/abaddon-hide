local function slider(parent, label, min, max, key, cb)
    local r = row(parent, 32)
    new("TextLabel", {
        Size = UDim2.new(1, 0, 0, 14), BackgroundTransparency = 1, Text = label, TextColor3 = C.Text,
        TextSize = 11, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 4,
    }, r)
    local tr = new("Frame", {
        Size = UDim2.new(1, 0, 0, 10), Position = UDim2.fromOffset(0, 18),
        BackgroundColor3 = C.Field, BorderSizePixel = 0, ZIndex = 4,
    }, r)
    stroke(tr, C.Black)
    local fill = new("Frame", {
        Size = UDim2.fromScale((State[key] - min) / (max - min), 1), BackgroundColor3 = C.Accent, BorderSizePixel = 0, ZIndex = 5,
    }, tr)
    gloss(fill)
    local val = new("TextLabel", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = tostring(State[key]),
        TextColor3 = C.White, TextSize = 10, Font = FONT, TextStrokeTransparency = 0.3, ZIndex = 7,
    }, tr)
    local function setV(v)
        v = math.clamp(math.floor(v + 0.5), min, max)
        State[key] = v
        fill.Size = UDim2.fromScale((v - min) / (max - min), 1)
        val.Text = tostring(v)
        if cb then cb(v) end
    end
    Reg[key] = setV
    local dragging = false
    local function setX(x)
        local rel = math.clamp((x - tr.AbsolutePosition.X) / math.max(1, tr.AbsoluteSize.X), 0, 1)
        setV(min + (max - min) * rel)
    end
    local hit = new("TextButton", {
        Size = UDim2.new(1, 0, 0, 22), Position = UDim2.fromOffset(0, 14), BackgroundTransparency = 1, Text = "", ZIndex = 8,
    }, r)
    hit.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            setX(i.Position.X)
        end
    end)
    track(UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
            setX(i.Position.X)
        end
    end))
    track(UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
end

