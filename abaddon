local M = {}

local function isSelf(m)
    if m == LP.Character or m.Name == LP.Name then return true end
    return Players:GetPlayerFromCharacter(m) == LP
end

-- villain = модель, внутри которой есть VillainCostume (кешируем на 1с)
local vcache = setmetatable({}, { __mode = "k" })
local function isVillain(m)
    local c = vcache[m]
    local now = os.clock()
    if c and now - c.t < 1 then return c.v end
    local v = m:FindFirstChild("VillainCostume", true) ~= nil
    vcache[m] = { t = now, v = v }
    return v
end

local function entries()
    local out = {}
    local f = workspace:FindFirstChild("Humanoids")
    if not f then return out end
    for _, m in ipairs(f:GetChildren()) do
        if m:IsA("Model") and not isSelf(m) then
            local hum = m:FindFirstChildOfClass("Humanoid")
            local root = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart")
            if root and (not hum or hum.Health > 0) then
                out[#out + 1] = { m = m, hum = hum, root = root, villain = isVillain(m) }
            end
        end
    end
    return out
end

local function displayName(m)
    local p = Players:GetPlayerFromCharacter(m)
    return p and p.DisplayName or m.Name
end

local function aimPart(m, root)
    if State.AimPart == "Head" then
        local h = m:FindFirstChild("Head")
        if h and h:IsA("BasePart") then return h end
    else
        for _, n in ipairs({ "UpperTorso", "Torso", "LowerTorso" }) do
            local p = m:FindFirstChild(n)
            if p and p:IsA("BasePart") then return p end
        end
    end
    return root
end

-- видимость: прозрачные и неколлизионные части не считаются преградой
local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude
rp.IgnoreWater = true
local function isVisible(part, m)
    local cam = workspace.CurrentCamera
    if not cam then return false end
    local ign = { cam }
    if LP.Character then ign[#ign + 1] = LP.Character end
    local origin = cam.CFrame.Position
    for _ = 1, 5 do
        rp.FilterDescendantsInstances = ign
        local res = workspace:Raycast(origin, part.Position - origin, rp)
        if not res then return true end
        local hit = res.Instance
        if hit:IsDescendantOf(m) then return true end
        if hit.Transparency >= 0.9 or not hit.CanCollide then
            ign[#ign + 1] = hit
        else
            return false
        end
    end
    return false
end

local function wantTarget(e)
    local w = State.AimTargets
    return w == "All" or (w == "Villain" and e.villain) or (w == "Survivors" and not e.villain)
end

----------------------------------------------------------------------
-- AIM
----------------------------------------------------------------------
do
    local circ = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, Visible = false, ZIndex = 3, Active = false,
    }, ScreenGui)
    new("UICorner", { CornerRadius = UDim.new(1, 0) }, circ)
    new("UIStroke", { Color = C.White, Thickness = 1, Transparency = 0.25 }, circ)

    local function keyHeld(name)
        if name == "Always" then return true end
        if name == "RMB" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
        if name == "LMB" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) end
        if name == "MB3" then return UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton3) end
        local ok, kc = pcall(function() return Enum.KeyCode[name] end)
        return ok and kc ~= nil and UIS:IsKeyDown(kc)
    end

    local function origin(cam)
        local o = State.AimOrigin
        if o == "Center" or (o == "Auto" and UIS.MouseBehavior == Enum.MouseBehavior.LockCenter) then
            return cam.ViewportSize / 2
        end
        return UIS:GetMouseLocation()
    end

    local function pickTarget(cam, ref)
        local best, bd
        for _, e in ipairs(entries()) do
            if wantTarget(e) then
                local part = aimPart(e.m, e.root)
                local sp = cam:WorldToViewportPoint(part.Position)
                if sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - ref).Magnitude
                    if d <= State.AimFOV and (not bd or d < bd) and (not State.AimVisible or isVisible(part, e.m)) then
                        best, bd = { e = e, part = part }, d
                    end
                end
            end
        end
        return best
    end

    local lock = nil
    local function aimStep(dt)
        local cam = workspace.CurrentCamera
        if not cam then return end
        local ref = origin(cam)

        circ.Visible = State.AimOn and State.AimDraw and not open
        if circ.Visible then
            circ.Size = UDim2.fromOffset(State.AimFOV * 2, State.AimFOV * 2)
            circ.Position = UDim2.fromOffset(ref.X, ref.Y)
        end

        if not State.AimOn or open or UIS:GetFocusedTextBox() or not keyHeld(State.AimKey) then
            lock = nil
            return
        end

        local target
        -- sticky: держим цель, пока жива и (если нужно) видна; если скрылась дольше 0.25с - отпускаем
        if State.AimSticky and lock then
            local folder = workspace:FindFirstChild("Humanoids")
            local alive2 = lock.m.Parent == folder and lock.root.Parent ~= nil and (not lock.hum or lock.hum.Health > 0)
            if alive2 then
                local part = aimPart(lock.m, lock.root)
                local now = os.clock()
                local vis = (not State.AimVisible) or isVisible(part, lock.m)
                if vis then lock.seen = now end
                if vis or now - lock.seen < 0.25 then
                    target = { part = part, hidden = not vis }
                end
            end
            if not target then lock = nil end
        end

        if not target then
            local t = pickTarget(cam, ref)
            if t then
                target = { part = t.part }
                if State.AimSticky then
                    lock = { m = t.e.m, hum = t.e.hum, root = t.e.root, seen = os.clock() }
                end
            end
        end

        if target and not target.hidden then
            local alpha = math.clamp(1 - State.AimSmooth / 100, 0.02, 1)
            alpha = 1 - (1 - alpha) ^ (dt * 60)
            cam.CFrame = cam.CFrame:Lerp(CFrame.lookAt(cam.CFrame.Position, target.part.Position), math.clamp(alpha, 0, 1))
        end
    end

    pcall(function()
        RunService:BindToRenderStep("AbaddonAim", Enum.RenderPriority.Camera.Value + 1, function(dt)
            local ok, err = pcall(aimStep, dt)
            if not ok then reportErr("aim", err) end
        end)
    end)
    onCleanup(function() pcall(function() RunService:UnbindFromRenderStep("AbaddonAim") end) end)
end

----------------------------------------------------------------------
-- ESP: Highlight + подпись, Survivors и Villain отдельно
----------------------------------------------------------------------
do
    local esp = {}
    local HL_CAP = 28

    local function dropEsp(m)
        local e = esp[m]
        if not e then return end
        esp[m] = nil
        pcall(function() e.bb:Destroy() end)
        if e.hl then pcall(function() e.hl:Destroy() end) end
    end

    local function put(e, col, wantHl)
        local o = esp[e.m]
        if o and (not o.bb.Parent or o.root ~= e.root) then
            dropEsp(e.m)
            o = nil
        end
        if not o then
            local bb = new("BillboardGui", {
                Name = "AbaddonESP", Adornee = e.root, AlwaysOnTop = true, Size = UDim2.fromOffset(200, 32),
                StudsOffset = Vector3.new(0, 3, 0), ResetOnSpawn = false,
            }, ScreenGui)
            local lbl = new("TextLabel", {
                Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, TextSize = 11, Font = FONT,
                TextStrokeTransparency = 0.3, TextWrapped = true, ZIndex = 2,
            }, bb)
            o = { bb = bb, lbl = lbl, root = e.root }
            esp[e.m] = o
        end

        local text = displayName(e.m) .. (e.villain and "  [VILLAIN]" or "")
        if State.ESPInfo then
            local hp = e.hum and string.format("%d/%d hp  |  ", math.floor(e.hum.Health), math.floor(e.hum.MaxHealth)) or ""
            text = text .. "\n" .. hp .. math.floor(e.d) .. "m"
        end
        o.lbl.Text = text
        o.lbl.TextColor3 = col

        if wantHl then
            if not o.hl or not o.hl.Parent then
                if o.hl then pcall(function() o.hl:Destroy() end) end
                o.hl = new("Highlight", { Name = "AbaddonHL" }, ScreenGui)
            end
            o.hl.Enabled = true
            o.hl.Adornee = e.m
            o.hl.FillColor, o.hl.OutlineColor = col, col
            o.hl.FillTransparency = State.ESPFill / 100
            o.hl.OutlineTransparency = 0
            o.hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            return true
        elseif o.hl then
            o.hl.Enabled = false
        end
        return false
    end

    every(0.12, function()
        local cam = workspace.CurrentCamera
        local seen = {}
        if cam and (State.ESPSurv or State.ESPVillain) then
            local origin = cam.CFrame.Position
            local list = {}
            for _, e in ipairs(entries()) do
                local show = (e.villain and State.ESPVillain) or (not e.villain and State.ESPSurv)
                if show then
                    e.d = (e.root.Position - origin).Magnitude
                    if e.d <= State.ESPMax then list[#list + 1] = e end
                end
            end
            -- villain первым (ему достаётся Highlight), дальше по расстоянию
            table.sort(list, function(a, b)
                if a.villain ~= b.villain then return a.villain end
                return a.d < b.d
            end)
            local hlN = 0
            for _, e in ipairs(list) do
                seen[e.m] = true
                local ok, res = pcall(put, e, e.villain and VILLAIN_COL or SURV_COL, State.ESPChams and hlN < HL_CAP)
                if ok then
                    if res then hlN += 1 end
                else
                    reportErr("esp", res)
                end
            end
        end
        for m in pairs(esp) do if not seen[m] then dropEsp(m) end end
    end)
    onCleanup(function() for m in pairs(esp) do dropEsp(m) end end)
end

