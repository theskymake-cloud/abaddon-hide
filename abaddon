local alive = true
local open = false
local Conns, Cleanups = {}, {}
local function track(c) Conns[#Conns + 1] = c return c end
local function onCleanup(f) Cleanups[#Cleanups + 1] = f end

local errSeen = {}
local function reportErr(tag, err)
    local k = tag .. tostring(err)
    if errSeen[k] then return end
    errSeen[k] = true
    warn("[abaddon] " .. tag .. ": " .. tostring(err))
end
local function hook(signal, fn)
    return track(signal:Connect(function(...)
        local ok, err = pcall(fn, ...)
        if not ok then reportErr("hook", err) end
    end))
end
local function every(t, fn)
    task.spawn(function()
        while alive do
            local ok, err = pcall(fn)
            if not ok then reportErr("loop", err) end
            task.wait(t)
        end
    end)
end

