local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    if parent then o.Parent = parent end
    return o
end
local function stroke(p, col)
    return new("UIStroke", { Color = col or C.Black, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, p)
end
local function gloss(p, b)
    return new("UIGradient", { Rotation = 90, Color = ColorSequence.new(C.White, b or rgb(130, 130, 130)) }, p)
end
local function tween(o, t, props)
    TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quart), props):Play()
end
