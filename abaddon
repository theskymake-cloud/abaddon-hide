        if not f then logErr("workspace.Humanoids not found") return end
        for _, m in ipairs(f:GetChildren()) do
            local names = {}
            for _, c in ipairs(m:GetChildren()) do names[#names + 1] = c.Name .. ":" .. c.ClassName end
            print(("[abaddon] %s%s%s -> %s"):format(m.Name, isVillain(m) and " (VILLAIN)" or "", isSelf(m) and " (you)" or "", table.concat(names, ", ")))
        end
        logOk("Dumped to F9")
    end)

    every(0.5, function()
        local f = workspace:FindFirstChild("Humanoids")
        if not f then
            statLbl.Text = "workspace.Humanoids not found"
            return
        end
        local total, surv, vill = 0, 0, 0
        for _, e in ipairs(entries()) do
            total += 1
            if e.villain then vill += 1 else surv += 1 end
        end
        statLbl.Text = string.format("in Humanoids: %d (without you, alive)\nsurvivors %d  |  villain %d", #f:GetChildren(), surv, vill)
    end)
end

----------------------------------------------------------------------
-- settings, glass, menu
----------------------------------------------------------------------
do
    local blur
    for _, o in ipairs(Lighting:GetChildren()) do
        if o.Name == "AbaddonBlur" then o:Destroy() end
    end
    blur = new("BlurEffect", { Name = "AbaddonBlur", Size = 0 }, Lighting)
    onCleanup(function() pcall(function() blur:Destroy() end) end)

    local function setMenu(v)
        if open == v then return end
        open = v
        if v then
            Panel.Visible, Overlay.Visible = true, true
            tween(Panel, 0.2, { GroupTransparency = 0 })
            tween(Overlay, 0.2, { BackgroundTransparency = 0.75 })
            tween(blur, 0.25, { Size = State.Blur and 16 or 0 })
        else
            if closeOpenDD then pcall(closeOpenDD) end
            tween(Panel, 0.15, { GroupTransparency = 1 })
            tween(Overlay, 0.15, { BackgroundTransparency = 1 })
            tween(blur, 0.2, { Size = 0 })
            task.delay(0.17, function()
                if not open then Panel.Visible, Overlay.Visible = false, false end
            end)
        end
    end
    CloseBtn.MouseButton1Click:Connect(function() setMenu(false) end)

    -- Modal-кнопка освобождает курсор в шутерах, пока меню открыто
    local modalBtn = new("TextButton", {
        Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, Text = "", Modal = false, ZIndex = 1,
    }, Panel)
    local baseSetMenu = setMenu
    setMenu = function(v)
        modalBtn.Modal = v
        baseSetMenu(v)
    end
    CloseBtn.MouseButton1Click:Connect(function() modalBtn.Modal = false end)

    local listening = false
    local bindBtn
    local function updateBind() bindBtn.Text = "Menu key: " .. State.MenuKey:lower() .. "   [click to change]" end

    hook(UIS.InputBegan, function(i, gp)
        if listening then
            if i.UserInputType == Enum.UserInputType.Keyboard then
                listening = false
                if i.KeyCode ~= Enum.KeyCode.Escape then State.MenuKey = i.KeyCode.Name end
                updateBind()
            end
            return
        end
        if gp then return end
        if i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode.Name == State.MenuKey then setMenu(not open) end
    end)

    -- scroll
    hook(UIS.InputChanged, function(i, gpe)
        if gpe or i.UserInputType ~= Enum.UserInputType.MouseWheel or not open then return end
        for _, page in pairs(Pages) do
            if page.Visible then
                local mouse = UIS:GetMouseLocation()
                local tl = page.AbsolutePosition
                local br = tl + page.AbsoluteSize
                if mouse.X >= tl.X and mouse.X <= br.X and mouse.Y >= tl.Y and mouse.Y <= br.Y then
                    local max = math.max(0, page.AbsoluteCanvasSize.Y - page.AbsoluteSize.Y)
                    page.CanvasPosition = Vector2.new(0, math.clamp(page.CanvasPosition.Y - i.Position.Z * 40, 0, max))
                    break
                end
            end
        end
    end)

    local CONFIG_FILE = "abaddon_humanoids.json"
    local function applyData(data)
        for k, v in pairs(data) do
            if DEFAULTS[k] ~= nil and type(v) == type(DEFAULTS[k]) then
                if Reg[k] then pcall(Reg[k], v) else State[k] = v end
            end
        end
    end
    local function saveCfg()
        if not writefile then logErr("writefile not supported") return end
        local data = {}
        for k, v in pairs(State) do
            local t = type(v)
            if t == "boolean" or t == "number" or t == "string" then data[k] = v end
        end
        local ok = pcall(function() writefile(CONFIG_FILE, HttpService:JSONEncode(data)) end)
        if ok then logOk("Config saved") else logErr("Config save failed") end
    end
    local function loadCfg(silent)
        if not (readfile and isfile) then if not silent then logErr("readfile not supported") end return end
        if not isfile(CONFIG_FILE) then if not silent then logWarn("No config file") end return end
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
        if not ok or type(data) ~= "table" then logErr("Config read failed") return end
        applyData(data)
        logOk("Config loaded")
    end

    local s = section(SetPage, "Menu")
    bindBtn = button(s, "", function()
        listening = true
        bindBtn.Text = "press a key...  (esc = cancel)"
    end)
    Reg.MenuKey = function(v) State.MenuKey = v updateBind() end
    updateBind()
    toggle(s, "Background blur", "Blur", function(v)
        if open then tween(blur, 0.2, { Size = v and 16 or 0 }) end
    end)

    s = section(SetPage, "Config")
    button(s, "Save config", saveCfg)
    button(s, "Load config", function() loadCfg(false) end)
    button(s, "Reset to defaults", function() applyData(DEFAULTS) logOk("Config reset") end)

    s = section(SetPage, "Script")
    button(s, "Unload script", function()
        if _G.AbaddonCleanup then _G.AbaddonCleanup() end
    end, true)

    -- liquid glass: полупрозрачные плоскости + мягкие обводки + блик, мир за меню размыт BlurEffect
    do
        Panel.BackgroundTransparency = 0.55
        Body.BackgroundTransparency = 0.45
        Sidebar.BackgroundTransparency = 0.6
        Card.BackgroundTransparency = 0.5

        for _, o in ipairs(Panel:GetDescendants()) do
            if (o:IsA("Frame") or o:IsA("TextButton") or o:IsA("TextBox") or o:IsA("TextLabel"))
                and o.BackgroundTransparency == 0 then
                local c = o.BackgroundColor3
                if c == C.Field or c == C.Side then
                    o.BackgroundTransparency = 0.45
                elseif c == C.Bg then
                    o.BackgroundTransparency = 0.2
                end
            end
        end
        for _, st in ipairs(Panel:GetDescendants()) do
            if st:IsA("UIStroke") then
                if st.Color == C.Border then
                    st.Color, st.Transparency = C.White, 0.86
                elseif st.Color == C.Black then
                    st.Transparency = 0.45
                end
            end
        end
        local ps = Panel:FindFirstChildOfClass("UIStroke")
        if ps then
            ps.Color, ps.Transparency = C.White, 0.25
            new("UIGradient", {
                Rotation = 45,
                Transparency = NumberSequence.new({
                    NumberSequenceKeypoint.new(0, 0),
                    NumberSequenceKeypoint.new(0.35, 0.75),
                    NumberSequenceKeypoint.new(0.65, 0.75),
                    NumberSequenceKeypoint.new(1, 0.1),
                }),
            }, ps)
        end
        local sheen = new("Frame", {
            Name = "GlassSheen", Size = UDim2.new(1, 0, 0.5, 0), BackgroundColor3 = C.White,
            BorderSizePixel = 0, ZIndex = 1, Active = false,
        }, Body)
        new("UIGradient", {
            Rotation = 90,
            Transparency = NumberSequence.new({
                NumberSequenceKeypoint.new(0, 0.86),
                NumberSequenceKeypoint.new(1, 1),
            }),
        }, sheen)
    end

    task.spawn(function()
        task.wait(0.3)
        pcall(loadCfg, true)
        setMenu(true)
        logOk("abaddon loaded  |  " .. State.MenuKey .. " = menu")
    end)
end
